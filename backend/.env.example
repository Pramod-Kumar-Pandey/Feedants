# Server
PORT=4000
NODE_ENV=development

# MongoDB
# For production/concurrency-safety this MUST point to a replica set or
# Atlas cluster (transactions require a replica set, even a single-node one).
MONGO_URI=mongodb://localhost:27017/feedants?replicaSet=rs0

# Auth
# Used to verify the Bearer token sent by the mobile app.
# In this assignment a minimal JWT auth is implemented; swap for your real
# identity provider in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=*
